{
  "type": "SCREEN",
  "note": "Menu des outils Krebbs (plugin KoriaKrebbs). Données : %var_krebbs_*%, list:krebbs_comment, list:krebbs_recompenses.",
  "width": 300,
  "height": 190,
  "anchor": "CENTER",
  "scaleMode": "ADAPT",
  "referenceWidth": 480,
  "referenceHeight": 270,
  "background": "#A0000000",
  "blur": true,
  "closeOnEscape": true,
  "openSound": "random.pop",
  "closeSound": "",
  "openAnimation": "ZOOM",
  "animationDuration": 200,
  "refreshTicks": 10,
  "elements": [
    {
      "type": "RECT",
      "id": "fond",
      "x": 0,
      "y": 0,
      "width": 300,
      "height": 190,
      "color": "#E60E141C",
      "radius": 8,
      "borderColor": "#FF3E7CB1",
      "borderWidth": 1
    },
    {
      "type": "RECT",
      "id": "bandeau",
      "x": 0,
      "y": 0,
      "width": 300,
      "height": 24,
      "color": "#FF14222E",
      "gradient": "#FF0E141C",
      "radius": 8
    },
    {
      "type": "TEXT",
      "id": "titre",
      "x": 0,
      "y": 7,
      "width": 300,
      "height": 12,
      "align": "CENTER",
      "text": "%var_krebbs_outil%",
      "scale": 1.25
    },
    {
      "type": "PAGES",
      "id": "vues",
      "x": 8,
      "y": 30,
      "width": 284,
      "height": 154,
      "transition": "SLIDE",
      "transitionDuration": 250,
      "clip": true,
      "children": [
        {
          "type": "GROUP",
          "id": "vue_outil",
          "name": "Page outil",
          "x": 0,
          "y": 0,
          "width": 284,
          "height": 154,
          "children": [
            {
              "type": "RECT",
              "id": "cadre_outil",
              "x": 0,
              "y": 0,
              "width": 110,
              "height": 122,
              "color": "#80000000",
              "radius": 6,
              "borderColor": "#FF2E4A60",
              "borderWidth": 1
            },
            {
              "type": "PROGRESS",
              "id": "anneau",
              "x": 15,
              "y": 6,
              "width": 80,
              "height": 80,
              "shape": "RING",
              "thickness": 5,
              "value": "%var_krebbs_xp%",
              "max": "%var_krebbs_requis%",
              "color": "#FF4FA8E0",
              "backgroundColor": "#40FFFFFF",
              "openAnimation": "ZOOM",
              "animationDuration": 350
            },
            {
              "type": "ITEM",
              "id": "outil",
              "x": 31,
              "y": 22,
              "width": 48,
              "height": 48,
              "item": "%var_krebbs_icone%",
              "mode": "MODEL3D",
              "spin": 45,
              "pitch": 15,
              "glint": true
            },
            {
              "type": "TEXT",
              "id": "niveau",
              "x": 0,
              "y": 90,
              "width": 110,
              "height": 12,
              "align": "CENTER",
              "text": "&7Niveau &b&l%var_krebbs_niveau%&7/&b%var_krebbs_max%",
              "scale": 1.1
            },
            {
              "type": "TEXT",
              "id": "niveau_detail",
              "x": 0,
              "y": 105,
              "width": 110,
              "height": 10,
              "align": "CENTER",
              "scale": 0.75,
              "text": "&7%var_krebbs_pourcent% vers le niveau %var_krebbs_prochain%",
              "condition": "%var_krebbs_max_atteint% != true"
            },
            {
              "type": "TEXT",
              "id": "niveau_max",
              "x": 0,
              "y": 105,
              "width": 110,
              "height": 10,
              "align": "CENTER",
              "scale": 0.8,
              "text": "&6&lNIVEAU MAXIMUM",
              "condition": "%var_krebbs_max_atteint% == true",
              "loopAnimation": "PULSE",
              "loopAmount": 0.05
            },
            {
              "type": "TEXT",
              "id": "xp_titre",
              "x": 120,
              "y": 0,
              "width": 164,
              "height": 10,
              "text": "&fExpérience",
              "scale": 0.9
            },
            {
              "type": "PROGRESS",
              "id": "barre_xp",
              "x": 120,
              "y": 12,
              "width": 164,
              "height": 12,
              "shape": "BAR",
              "radius": 3,
              "value": "%var_krebbs_xp%",
              "max": "%var_krebbs_requis%",
              "color": "#FF4FA8E0",
              "backgroundColor": "#A0000000",
              "borderColor": "#FF2E4A60",
              "borderWidth": 1,
              "text": "{value} / {max} XP",
              "scale": 0.75,
              "condition": "%var_krebbs_max_atteint% != true"
            },
            {
              "type": "PROGRESS",
              "id": "barre_xp_max",
              "x": 120,
              "y": 12,
              "width": 164,
              "height": 12,
              "shape": "BAR",
              "radius": 3,
              "value": "1",
              "max": "1",
              "color": "#FFE0A030",
              "backgroundColor": "#A0000000",
              "text": "&lNiveau maximum atteint",
              "scale": 0.75,
              "condition": "%var_krebbs_max_atteint% == true"
            },
            {
              "type": "TEXT",
              "id": "comment_titre",
              "x": 120,
              "y": 32,
              "width": 164,
              "height": 10,
              "text": "&eComment gagner de l'XP ?",
              "scale": 0.9
            },
            {
              "type": "REPEATER",
              "id": "comment",
              "x": 120,
              "y": 44,
              "width": 164,
              "height": 52,
              "source": "list:krebbs_comment",
              "itemWidth": 164,
              "itemHeight": 10,
              "spacing": 0,
              "direction": "VERTICAL",
              "scroll": "VERTICAL",
              "clip": true,
              "emptyText": "&8Aucune indication",
              "children": [
                {
                  "type": "TEXT",
                  "id": "comment_ligne",
                  "x": 0,
                  "y": 0,
                  "width": 164,
                  "height": 10,
                  "text": "{item}",
                  "scale": 0.75
                }
              ]
            },
            {
              "type": "RECT",
              "id": "prochaine_fond",
              "x": 120,
              "y": 98,
              "width": 164,
              "height": 24,
              "color": "#60000000",
              "radius": 4,
              "borderColor": "#FF2E4A60",
              "borderWidth": 1,
              "condition": "%var_krebbs_max_atteint% != true"
            },
            {
              "type": "TEXT",
              "id": "prochaine",
              "x": 124,
              "y": 101,
              "width": 156,
              "height": 20,
              "scale": 0.72,
              "wrap": true,
              "text": "&7Récompense du niveau &b%var_krebbs_prochain%&7 :\n&f%var_krebbs_prochaine%",
              "condition": "%var_krebbs_max_atteint% != true"
            },
            {
              "type": "BUTTON",
              "id": "bouton_recompenses",
              "x": 0,
              "y": 130,
              "width": 138,
              "height": 20,
              "text": "&6Récompenses",
              "actions": ["page: vues 2"],
              "color": "#C0182430",
              "hoverColor": "#E0243A4C",
              "borderColor": "#FF2E4A60",
              "hoverBorderColor": "#FF4FA8E0",
              "borderWidth": 1,
              "radius": 4,
              "hoverScale": 1.03,
              "clickSound": true,
              "icon": "minecraft:chest"
            },
            {
              "type": "BUTTON",
              "id": "fermer",
              "x": 146,
              "y": 130,
              "width": 138,
              "height": 20,
              "text": "&cFermer",
              "actions": ["close"],
              "color": "#C0182430",
              "hoverColor": "#E0243A4C",
              "borderColor": "#FF2E4A60",
              "hoverBorderColor": "#FF4FA8E0",
              "borderWidth": 1,
              "radius": 4,
              "hoverScale": 1.03,
              "clickSound": true
            }
          ]
        },
        {
          "type": "GROUP",
          "id": "vue_recompenses",
          "name": "Page récompenses",
          "x": 0,
          "y": 0,
          "width": 284,
          "height": 154,
          "children": [
            {
              "type": "TEXT",
              "id": "recompenses_titre",
              "x": 0,
              "y": 0,
              "width": 284,
              "height": 12,
              "align": "CENTER",
              "text": "&6Récompenses &8- %var_krebbs_outil%"
            },
            {
              "type": "REPEATER",
              "id": "recompenses",
              "x": 7,
              "y": 15,
              "width": 270,
              "height": 111,
              "source": "list:krebbs_recompenses",
              "itemWidth": 50,
              "itemHeight": 24,
              "spacing": 5,
              "direction": "GRID",
              "columns": 5,
              "scroll": "VERTICAL",
              "clip": true,
              "children": [
                {
                  "type": "RECT",
                  "id": "case_obtenue",
                  "x": 0,
                  "y": 0,
                  "width": 50,
                  "height": 24,
                  "color": "#C0143A22",
                  "borderColor": "#FF55FF55",
                  "borderWidth": 1,
                  "radius": 4,
                  "condition": "\"{item.statut}\" == \"obtenu\"",
                  "tooltip": "{item.infobulle}",
                  "hoverColor": "#40FFFFFF"
                },
                {
                  "type": "RECT",
                  "id": "case_prochaine",
                  "x": 0,
                  "y": 0,
                  "width": 50,
                  "height": 24,
                  "color": "#C0403410",
                  "borderColor": "#FFFFCC33",
                  "borderWidth": 1,
                  "radius": 4,
                  "condition": "\"{item.statut}\" == \"prochain\"",
                  "tooltip": "{item.infobulle}",
                  "hoverColor": "#40FFFFFF",
                  "loopAnimation": "PULSE",
                  "loopAmount": 0.04
                },
                {
                  "type": "RECT",
                  "id": "case_verrouillee",
                  "x": 0,
                  "y": 0,
                  "width": 50,
                  "height": 24,
                  "color": "#C0181818",
                  "borderColor": "#FF444444",
                  "borderWidth": 1,
                  "radius": 4,
                  "condition": "\"{item.statut}\" == \"verrouille\"",
                  "tooltip": "{item.infobulle}",
                  "hoverColor": "#40FFFFFF"
                },
                {
                  "type": "TEXT",
                  "id": "case_niveau",
                  "x": 0,
                  "y": 3,
                  "width": 50,
                  "height": 10,
                  "align": "CENTER",
                  "text": "{item.couleur}&lNiv. {item.niveau}"
                },
                {
                  "type": "TEXT",
                  "id": "case_resume",
                  "x": 2,
                  "y": 14,
                  "width": 46,
                  "height": 8,
                  "align": "CENTER",
                  "scale": 0.55,
                  "text": "&7{item.resume}"
                }
              ]
            },
            {
              "type": "BUTTON",
              "id": "retour",
              "x": 0,
              "y": 130,
              "width": 138,
              "height": 20,
              "text": "&eRetour",
              "actions": ["page: vues 1"],
              "color": "#C0182430",
              "hoverColor": "#E0243A4C",
              "borderColor": "#FF2E4A60",
              "hoverBorderColor": "#FF4FA8E0",
              "borderWidth": 1,
              "radius": 4,
              "hoverScale": 1.03,
              "clickSound": true,
              "icon": "minecraft:arrow"
            },
            {
              "type": "BUTTON",
              "id": "fermer_recompenses",
              "x": 146,
              "y": 130,
              "width": 138,
              "height": 20,
              "text": "&cFermer",
              "actions": ["close"],
              "color": "#C0182430",
              "hoverColor": "#E0243A4C",
              "borderColor": "#FF2E4A60",
              "hoverBorderColor": "#FF4FA8E0",
              "borderWidth": 1,
              "radius": 4,
              "hoverScale": 1.03,
              "clickSound": true
            }
          ]
        }
      ]
    }
  ]
}
